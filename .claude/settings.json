{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/help_freshness_nudge.py\"",
            "timeout": 5,
            "statusMessage": "Checking .help freshness..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/starter_prompt_nudge.py\"",
            "timeout": 3,
            "statusMessage": "Checking for cross-session handoff..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/starter_reconciler.py\"",
            "timeout": 12,
            "statusMessage": "Reconciling handoff freshness..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/lessons_reminder.py\"",
            "timeout": 5,
            "statusMessage": "Checking for lessons to record..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/security_guard.py\"",
            "timeout": 5,
            "statusMessage": "Security check..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/security_guard.py\"",
            "timeout": 5,
            "statusMessage": "Path validation..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/worktree_path_guard.py\"",
            "timeout": 5,
            "statusMessage": "Worktree path check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/format_on_save.py\"",
            "timeout": 10,
            "statusMessage": "Auto-formatting..."
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/attune/hooks/scripts/telemetry_hook.py\"",
            "timeout": 3,
            "statusMessage": "Recording telemetry..."
          }
        ]
      }
    ]
  }
}
