{
  "name": "website",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:migration-banner && npm run build:docs && next build",
    "build:vercel": "npm run check:migration-banner && next build",
    "build:railway": "npm run check:migration-banner && next build",
    "build:docs": "cd .. && mkdocs build --clean && rm -rf website/public/framework-docs && cp -r site website/public/framework-docs",
    "check:migration-banner": "tsx scripts/check-migration-banner.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.1",
    "@sendgrid/mail": "^8.1.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.8.2",
    "next": "15.5.22",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "reading-time-estimator": "^1.14.0",
    "recharts": "^3.6.0",
    "rehype-highlight": "^7.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.5.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
