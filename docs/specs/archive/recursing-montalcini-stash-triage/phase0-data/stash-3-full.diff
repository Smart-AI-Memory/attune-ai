+class TestResolveShowCost:
+    """show_cost precedence: explicit > env override > API-key auto."""
+
+    def test_explicit_override_wins(self, monkeypatch):
+        from attune.voice.formatter import _resolve_show_cost
+
+        monkeypatch.setenv("ANTHROPIC_API_KEY", "sk-test")  # pragma: allowlist secret
+        assert _resolve_show_cost(explicit=False) is False
+        monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+        assert _resolve_show_cost(explicit=True) is True
+
+    def test_env_override_when_no_explicit(self, monkeypatch):
+        from attune.voice.formatter import _resolve_show_cost
+
+        monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+        monkeypatch.setenv("ATTUNE_SHOW_COST_METRICS", "1")
+        assert _resolve_show_cost() is True
+        monkeypatch.setenv("ATTUNE_SHOW_COST_METRICS", "false")
+        assert _resolve_show_cost() is False
+
+    def test_api_key_auto_detect(self, monkeypatch):
+        from attune.voice.formatter import _resolve_show_cost
+
+        monkeypatch.delenv("ATTUNE_SHOW_COST_METRICS", raising=False)
+        monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+        assert _resolve_show_cost() is False
+        monkeypatch.setenv("ANTHROPIC_API_KEY", "sk-test")  # pragma: allowlist secret
+        assert _resolve_show_cost() is True
