+def _resolve_run(request: Request, run_id: str) -> Run | None:
+    """Look up a run by id, checking in-memory then disk.
+
+    The in-memory runner cache holds the last N runs (default 20).
+    Older runs are persisted to ``<runs_dir>/<workflow>/<id>.json``
+    by the runner service. This helper checks both, so refreshing
+    a run-view page after eviction (or after a server restart)
+    still finds the run instead of 404-ing — see P3-2 in the
+    2026-05-14 QA punch list.
+
+    Returns the live ``Run`` from memory when present, otherwise
+    a read-only ``Run`` reconstructed from disk (no subscribers,
+    no SSE — the run is terminal by definition).
+    """
+    svc = _service(request)
+    run = svc.get(run_id)
+    if run is not None:
+        return run
+
+    cfg = getattr(request.app.state, "config", None)
+    runs_dir = getattr(cfg, "runs_dir", None) if cfg is not None else None
+    if runs_dir is None:
+        return None
+
+    # _load_run_record needs (runs_dir, workflow, run_id). The route
+    # only has run_id, so we scan workflow subdirs for a matching
+    # file. Cost is bounded by the small number of workflow dirs
+    # (one per workflow ever persisted, ~10-20 in practice).
+    try:
+        for workflow_dir in runs_dir.iterdir():
+            if not workflow_dir.is_dir():
+                continue
+            record = _load_run_record(runs_dir, workflow_dir.name, run_id)
+            if record is not None:
+                return Run.from_record(record)
+    except (OSError, ValueError) as exc:
+        logger.debug("disk run lookup failed for %s: %s", run_id, exc)
+    return None
+
+
