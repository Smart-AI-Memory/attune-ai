+                "import json, os;"
+                "p = os.environ.get('ATTUNE_REPORT_SIDECAR_PATH');"
+                "open(p, 'w').write(json.dumps({'title': 'subprocess', 'sections': []}));"
+                "print('done')"
+            )
+            return (sys.executable, "-c", script)
+
+        svc = RunnerService(command_builder=cmd_builder, history_limit=5)
+        run = await svc.start("release-prep")
+        for _ in range(50):
+            if run.is_terminal:
+                break
+            await asyncio.sleep(0.05)
+        assert run.is_terminal, "subprocess never completed"
+        assert run.report == {"title": "subprocess", "sections": []}
