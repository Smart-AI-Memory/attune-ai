+def _emit_report_sidecar(result: object) -> None:
+    """Write a structured ``WorkflowReport`` to the runner sidecar path.
+
+    When the ops runner spawns this CLI as a subprocess it sets
+    ``ATTUNE_REPORT_SIDECAR_PATH`` in the environment. If the
+    workflow returned a ``WorkflowReport`` (or wrapped one in a
+    ``WorkflowResult.final_output``), serialize it via ``to_dict``
+    and write to that path. The runner reads it after the subprocess
+    exits and stores it on the ``Run`` record for the dashboard.
+
+    Best-effort: failures are swallowed (with debug logging) so a
+    sidecar I/O issue never breaks the workflow run for the user.
+    No-op when the env var is unset (the normal CLI-only case).
+    """
+    import json
+    import os
+    from pathlib import Path
+
+    sidecar = os.environ.get("ATTUNE_REPORT_SIDECAR_PATH")
+    if not sidecar:
+        return
+
+    try:
+        from attune.workflows.output import WorkflowReport
+    except ImportError:
+        return
+
+    report: WorkflowReport | None = None
+    if isinstance(result, WorkflowReport):
+        report = result
+    else:
+        final_output = getattr(result, "final_output", None)
+        if isinstance(final_output, WorkflowReport):
+            report = final_output
+
+    if report is None:
+        return
+
+    try:
+        Path(sidecar).write_text(
+            json.dumps(report.to_dict()),
+            encoding="utf-8",
+        )
+    except (OSError, TypeError, ValueError) as exc:
+        logger.debug("Failed to write report sidecar %s: %s", sidecar, exc)
