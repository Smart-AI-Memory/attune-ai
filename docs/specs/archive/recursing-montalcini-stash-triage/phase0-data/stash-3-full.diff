+    def to_report(self):
+        """Convert to a generic ``WorkflowReport`` for the voice layer.
+
+        This is the migration entry point per the
+        workflow-result-formatting spec. The voice / CLI / dashboard /
+        MCP surfaces all consume ``WorkflowReport``; bespoke types
+        like this one stay as the workflow's INTERNAL data model and
+        cross the surface boundary via ``to_report()``.
+
+        Section tiering follows the design principle "scannable
+        first, readable second":
+
+        - **essential**: verdict callout, quality gates table,
+          blockers, warnings, next steps
+        - **detail**: per-agent breakdown (collapsed by default
+          on the dashboard, hidden behind ``--verbose`` on the CLI)
+
+        Returns:
+            ``WorkflowReport`` instance.
+        """
+        # Local import to avoid cycles at module load.
+        from attune.workflows.output import (
+            CalloutSection,
+            ListSection,
+            NextAction,
+            NextStepsSection,
+            TableSection,
+            WorkflowReport,
+        )
+
+        sections: list[Any] = []
+
+        # Verdict callout (essential)
+        verdict = "APPROVED" if self.approved else "BLOCKED"
+        emphasis = "ok" if self.approved else "danger"
+        sections.append(
+            CalloutSection(
+                title="Verdict",
+                tier="essential",
+                text=f"Release **{verdict}** — confidence: {self.confidence}",
+                emphasis=emphasis,
+            ),
+        )
+
+        # Quality gates table (essential) — only when there are gates
+        if self.quality_gates:
+            passed = sum(1 for g in self.quality_gates if g.passed)
+            total = len(self.quality_gates)
+            sections.append(
+                TableSection(
+                    title=f"Quality Gates ({passed}/{total} passed)",
+                    tier="essential",
+                    columns=["Gate", "Actual", "Threshold", "Pass"],
+                    rows=[
+                        {
+                            "Gate": g.name,
+                            "Actual": f"{g.actual:.1f}",
+                            "Threshold": f"{g.threshold:.1f}",
+                            "Pass": "X" if g.passed else "F",
+                        }
+                        for g in self.quality_gates
+                    ],
+                ),
+            )
+
+        # Blockers (essential) — only when present
+        if self.blockers:
+            sections.append(
+                ListSection(
+                    title="Blockers",
+                    tier="essential",
+                    items=list(self.blockers),
+                ),
+            )
+
+        # Warnings (essential) — only when present
+        if self.warnings:
+            sections.append(
+                ListSection(
+                    title="Warnings",
+                    tier="essential",
+                    items=list(self.warnings),
+                ),
+            )
+
+        # Per-agent breakdown (detail) — only when there are results
+        if self.agent_results:
+            sections.append(
+                TableSection(
+                    title="Per-agent breakdown",
+                    tier="detail",
+                    columns=["Agent", "Score", "Time"],
+                    rows=[
+                        {
+                            "Agent": r.agent_role,
+                            "Score": f"{r.score:.1f}",
+                            "Time": f"{r.execution_time_ms / 1000:.1f}s",
+                        }
+                        for r in self.agent_results
+                    ],
+                ),
+            )
+
+        # Next steps (essential) — outcome-conditional
+        next_steps: list[NextAction] = []
+        if self.approved:
+            next_steps.append(
+                NextAction(
+                    text="All gates pass. Cut the release.",
+                    command="attune release prep",
+                ),
+            )
+        else:
+            for blocker in self.blockers:
+                next_steps.append(NextAction(text=f"Resolve blocker: {blocker}"))
+        if next_steps:
+            sections.append(
+                NextStepsSection(
+                    title="Next steps",
+                    tier="essential",
+                    items=next_steps,
+                ),
+            )
+
+        return WorkflowReport(
+            title="Release readiness",
+            summary=self.summary or f"Release {verdict} — confidence: {self.confidence}",
+            sections=sections,
+            metadata={
+                "total_duration": self.total_duration,
+                "total_cost": self.total_cost,
+                "confidence": self.confidence,
+            },
+        )
+
