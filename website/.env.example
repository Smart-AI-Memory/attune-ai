# ===========================================
# Empathy Framework Website Environment Config
# ===========================================

# Deployment
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://smartaimemory.com

# ===========================================
# Database (Railway PostgreSQL)
# ===========================================
# Get from Railway: Project → PostgreSQL → Connect → Connection URL
DATABASE_URL=postgresql://user:password@host:5432/railway

# Admin secret for database initialization (generate a random string)
# Required for POST /api/db/init and the manual usage-digest path
# (x-admin-secret header). Must be NON-EMPTY — a blank value is refused,
# never treated as "no password". Generate one:  openssl rand -hex 32
ADMIN_SECRET=your_random_admin_secret_here

# ===========================================
# Email Service (Resend - Recommended)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email addresses
FROM_EMAIL=Empathy <noreply@smartaimemory.com>
SUPPORT_EMAIL=admin@smartaimemory.com

# ===========================================
# Email Notifications (SendGrid)
# ===========================================
# Required for contact form and newsletter confirmation emails
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@smartaimemory.com

# Where contact form submissions are sent
CONTACT_EMAIL=patrick.roebuck@smartaimemory.com

# ===========================================
# Newsletter Management (Mailchimp)
# ===========================================
# Get from: https://mailchimp.com/developer/marketing/api/root/
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_audience_list_id
MAILCHIMP_SERVER_PREFIX=us1

# ===========================================
# Analytics
# ===========================================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=smartaimemory.com
# Optional: Self-hosted Plausible
# NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# ===========================================
# GitHub API (for stats - optional)
# ===========================================
# Add token for higher rate limits
# GITHUB_TOKEN=your_github_personal_access_token
